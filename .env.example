# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/safeclass_db"

# JWT
JWT_SECRET="change_this_to_a_random_256_bit_secret"
JWT_EXPIRES_IN="60m"
JWT_REFRESH_SECRET="change_this_to_another_random_secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

# Frontend origin (CORS)
FRONTEND_URL="http://localhost:5173"

# Password reset token TTL in minutes
RESET_TOKEN_TTL_MINUTES=30

# Model service integration
# URL of the safeclass-model-service (Python · FastAPI · port 8001)
MODEL_SERVICE_URL="http://localhost:8001"
# Shared secret for authenticating webhooks sent BY the model service TO this backend.
# Must match BACKEND_API_KEY in the model service .env.
# Leave empty to disable authentication in development.
MODEL_SERVICE_API_KEY="change_this_to_match_model_service_BACKEND_API_KEY"
